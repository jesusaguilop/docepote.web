# ─────────────────────────────────────────────────────────────
#  Doce pote — variables de entorno
#  Copia este archivo como .env y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# ─── Base de datos ───────────────────────────────────────────
# Local (SQLite, sin instalar nada):
DATABASE_URL="file:./dev.db"

# Producción con Supabase — corre antes: npm run db:use-postgres
# DATABASE_URL es la conexión con pooler (puerto 6543): la usa la app,
# porque en serverless se abren y cierran conexiones todo el tiempo.
# DIRECT_URL es la conexión directa (puerto 5432): la usa Prisma para
# crear y migrar tablas, algo que el pooler no soporta.
#
# DATABASE_URL="postgresql://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Datos públicos del negocio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="573180173770"
NEXT_PUBLIC_INSTAGRAM="docepotevup"

# Pasarela de pago activa: "whatsapp" | "wompi"
PAYMENT_GATEWAY="whatsapp"

# Wompi (solo si PAYMENT_GATEWAY=wompi)
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
WOMPI_ENVIRONMENT="sandbox"

# Costo de domicilio dentro de Valledupar, en pesos colombianos
DELIVERY_FEE_COP="5000"
FREE_DELIVERY_THRESHOLD_COP="60000"

# Credenciales del administrador que crea el seed
ADMIN_EMAIL="hola@docepote.com"
ADMIN_PASSWORD="docepote2026"
ADMIN_NAME="Equipo Doce pote"

# Secreto para firmar cookies de sesión (cámbialo en producción)
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
