# ─────────────────────────────────────────────────────────────
#  DOCEPOTE — variables de entorno
#  Copia este archivo como .env y ajusta lo que necesites.
#
#  Solo DATABASE_URL es obligatoria. Todo lo demás tiene un valor por
#  defecto sensato: si lo dejas vacío o mal escrito, la tienda sigue
#  funcionando y avisa por consola en vez de caerse.
# ─────────────────────────────────────────────────────────────

# ═══ OBLIGATORIA ═════════════════════════════════════════════

# Local (SQLite, sin instalar nada):
DATABASE_URL="file:./dev.db"

# Producción con Neon — el esquema del repo ya viene en PostgreSQL.
#
#   DATABASE_URL → conexión con pooler (lleva "-pooler" en el host). La usa
#   la app: en serverless se abren y cierran conexiones sin parar, y sin
#   pooler se agota el límite de Postgres.
#
#   DIRECT_URL → conexión directa (sin "-pooler"). Solo la usa Prisma para
#   crear y migrar tablas desde tu máquina; el pooler no soporta esas
#   operaciones. NO hace falta configurarla en Vercel.
#
# DATABASE_URL="postgresql://usuario:CLAVE@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://usuario:CLAVE@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"


# ═══ OPCIONALES ══════════════════════════════════════════════
#
# Ninguna lleva prefijo NEXT_PUBLIC_ a propósito: todas se leen en el
# servidor y bajan a los componentes como props, así que no viajan al
# navegador. De paso se leen en ejecución y no al compilar — cambiar el
# número de WhatsApp no obliga a recompilar.

# ─── Negocio ─────────────────────────────────────────────────

# Dominio público. En Vercel puedes omitirla: se detecta sola con
# VERCEL_PROJECT_PRODUCTION_URL. Fíjala cuando tengas dominio propio.
# SITE_URL="https://docepote.com"

# Número que recibe los pedidos.
# Acepta "+57 318 0173770", "318 017 3770" o "3180173770": se normaliza solo.
# Por defecto: 573180173770
WHATSAPP_NUMBER="573180173770"

# Usuario de Instagram. Acepta "docepotevup", "@docepotevup" o la URL
# completa que copia el botón de compartir. Por defecto: docepotevup
INSTAGRAM="docepotevup"

# ─── Entrega ─────────────────────────────────────────────────

# Pesos colombianos. Acepta "5000" o "5.000". Por defecto: 5000 y 60000.
DELIVERY_FEE_COP="5000"
FREE_DELIVERY_THRESHOLD_COP="60000"

# ─── Pagos ───────────────────────────────────────────────────

# "whatsapp" | "wompi". Por defecto: whatsapp.
#
# Wompi está implementado y listo, pero DORMIDO: aunque pongas "wompi", si
# faltan sus llaves la tienda sigue cobrando por WhatsApp y lo avisa por
# consola, en lugar de dejar de vender.
PAYMENT_GATEWAY="whatsapp"

# Solo si PAYMENT_GATEWAY="wompi". Se necesitan las tres para que se active.
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
WOMPI_ENVIRONMENT="sandbox"

# ─── Seed ────────────────────────────────────────────────────
# Solo las lee `npm run db:seed`, nunca la aplicación.

ADMIN_EMAIL="hola@docepote.com"
ADMIN_PASSWORD="docepote2026"
ADMIN_NAME="Equipo DOCEPOTE"
